<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The fix names its new steps TODO_ placeholders, which CR1700 keeps reported until renamed. -->
    <WarningsNotAsErrors>CR1700</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anton.CodingRules" Version="0.0.0" />
  </ItemGroup>
</Project>
