# Roslynator 5.0.1 allowlist. See docs/formatting.md for provenance and upgrade checks.
# Lower priority than consumer globalconfigs and .editorconfig.
is_global = true
global_level = -100

# Compact properties must survive the standard formatter.
csharp_preserve_single_line_blocks = true
roslynator_use_block_body_when_expression_spans_over_multiple_lines = true

